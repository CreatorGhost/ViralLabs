# YouTube Automation Stack - Development Backend Image
# Backend only with hot reload support

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --upgrade pip uv && uv pip install --system -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY src/ ./src/
COPY main.py ./

# Create necessary directories
RUN mkdir -p generated_thumbnails user_data/faces user_data/audio uploads

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run with hot reload for development
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]

