# YouTube Automation Stack - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS (Required for AI features)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_API_KEY=your-google-api-key-here
YOUTUBE_API_KEY=your-youtube-api-key-here

# =============================================================================
# DATABASE (Docker Compose uses these)
# =============================================================================
POSTGRES_USER=youtuber
POSTGRES_PASSWORD=youtuber123
POSTGRES_DB=youtuber

# For local development (without Docker)
DATABASE_URL=postgresql+asyncpg://youtuber:youtuber123@localhost:5432/youtuber

# =============================================================================
# SECURITY
# =============================================================================
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=change-this-to-a-very-long-random-string-in-production

# =============================================================================
# CLOUDFLARE R2 STORAGE (Optional - defaults to local storage)
# =============================================================================
STORAGE_MODE=local
# Set to "r2" to use CloudFlare R2 storage

# R2 Credentials (only needed if STORAGE_MODE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=virallab-media
R2_PUBLIC_URL=

